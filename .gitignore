# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

vite.config.*.timestamp*
vitest.config.*.timestamp*

# Environment variables
# Ignore all real .env files
.env
.env.*
.env.local
.env.*.local

# Ignore per-app .env files (Nx apps live in apps/* or libs/*)
apps/**/.env
apps/**/.env.*
apps/**/.env.local
apps/**/.env.*.local

# Allow non-sensitive templates
!.env.example
!apps/**/.env.example

# Playwright authenticated browser state (generated locally)
/web-admin-e2e/playwright/.auth/
